{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "collector:setup": "npm --prefix integrations/socialmonitor install",
    "collector:browser": "npm --prefix integrations/socialmonitor exec -- playwright install chromium",
    "collector:login": "node integrations/socialmonitor/worker.mjs login",
    "collector:test": "node --test integrations/socialmonitor/worker.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:analysis": "node --test tests/analysis-panels.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
